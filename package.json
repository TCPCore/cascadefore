{
  "name": "cascade",
  "version": "0.1.0",
  "private": true,
  "description": "Cascade \u2014 counterfactual decision-path reconstruction for Jira, built on Forge + Teamwork Graph.",
  "license": "Apache-2.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:panel": "npm --prefix static/panel run build",
    "verify": "bash scripts/verify.sh",
    "lint": "forge lint",
    "deploy": "forge deploy",
    "install:app": "forge install",
    "register:queries": "forge invoke --function register-queries",
    "build:web": "npm --prefix static/panel run build:web",
    "serve:web": "npm run build:web && tsx scripts/serve.ts",
    "render:report": "tsx scripts/render.ts",
    "sandbox": "CASCADE_SOURCE=live CASCADE_STORE=sqlite CASCADE_DB=/tmp/cascade.db tsx scripts/serve.ts",
    "shots": "node scripts/shoot.mjs",
    "demo:record": "node scripts/record-demo.mjs",
    "a11y": "node scripts/a11y.mjs",
    "listing:assets": "node scripts/listing-assets.mjs",
    "shots:mobile": "node scripts/mobile-shot.mjs"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/events": "^3.0.9",
    "@forge/llm": "^1.0.9",
    "@forge/resolver": "^2.0.2",
    "@forge/sql": "^4.0.9",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "playwright": "^1.65.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
